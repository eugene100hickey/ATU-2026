my_boxoffice <- function(look_back = 7) {
dates <- (Sys.Date()-look_back) |>
str_replace_all("-", "/")
my_xml <- "tbody .data , .chart-desktop a"
my_url <- glue::glue("https://www.the-numbers.com/box-office-chart/daily/{dates}")
z <- read_html(my_url)
z1 <- html_elements(z, my_xml)
z2 <- html_text2(z1)
titles <- z2[seq(3, 93, 10)]
weekly <- z2[seq(4, 94, 10)] |>
str_remove_all("\\$") |>
str_remove_all(",") |>
as.numeric()
total <- z2[seq(9, 99, 10)] |>
str_remove_all("\\$") |>
str_remove_all(",") |>
as.numeric()
tibble(titles, weekly, total)
}
